# Curio Wiki environment configuration
# Copy to .env.local for development. NEVER commit real keys (.env* is gitignored; .env.example is the committed template).

# ── YouTube Data API v3 ────────────────────────────────────────────────────────
# Required by: /videos pages + YouTube section of unified search.
# Get a key: https://console.cloud.google.com/ → create project → enable
# "YouTube Data API v3" → APIs & Services → Credentials → Create API key.
# SERVER-SIDE ONLY (never NEXT_PUBLIC_*). In development do NOT set referrer
# restrictions (localhost behavior is undocumented); restrict in production.
# Without it: YouTube sections show an honest "not configured" state.
YOUTUBE_API_KEY=

# ── Tavily web search (default general web-search provider) ───────────────────
# Free 1,000 credits/month, no credit card: https://tavily.com → sign up → API key.
# SERVER-SIDE ONLY. Without it (and without BRAVE_SEARCH_API_KEY) the Web
# resources section shows a classified "not configured" error.
TAVILY_API_KEY=

# ── Brave Search API (OPTIONAL alternative web provider) ──────────────────────
# Only used when TAVILY_API_KEY is unset. Free tier requires a credit card to
# obtain: https://brave.com/search/api/. Sent as X-Subscription-Token. SERVER-SIDE ONLY.
BRAVE_SEARCH_API_KEY=

# ── Supabase (authentication + saved resources) ───────────────────────────────
# Create a free project: https://supabase.com/dashboard → New project.
# Project Settings → API → copy Project URL and Publishable (anon) key.
# Then run the SQL in supabase/migrations/0001_saved_resources.sql in the
# SQL editor (or `supabase db push`). Google OAuth setup: Authentication →
# Providers → Google (client id + secret from Google Cloud Console, authorized
# redirect URI https://<project-ref>.supabase.co/auth/v1/callback).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional server-only secret for admin operations (never exposed to browser).
SUPABASE_SECRET_KEY=

# ── Site URL ───────────────────────────────────────────────────────────────────
# Used for OAuth redirect targets. Default: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
